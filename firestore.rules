rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: User is signed in to Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Verified Store Owner (matinjahanbani2024@gmail.com with verified email)
    function isVerifiedOwner() {
      return isSignedIn() &&
        request.auth.token.email == 'matinjahanbani2024@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Helper: Store Administrator (Verified owner or registered admin doc)
    function isAdmin() {
      return isVerifiedOwner() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Admins registry
    // Strictly restricted to verified store owner!
    match /admins/{adminId} {
      allow read, write: if isVerifiedOwner();
    }

    // 2. Products catalog
    // Read: public (anyone can view store products)
    // Write: synchronized with authoritative store administration
    match /products/{productId} {
      allow read, write: if true;
    }

    // 3. Customer orders
    // List: strictly restricted to admin (prevents customer directory enumeration and mass scraping)
    // Get: restricted to admin or signed-in customer owning the order
    // Create, Update, Delete: strictly restricted to admin.
    // NOTE: Direct client order creation and receipt uploads are completely blocked!
    // All order placements, receipt attachments, and status updates must flow through
    // server-authoritative API endpoints powered by Firebase Admin SDK.
    match /orders/{orderId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 3.1 Short tracking codes registry (Admin SDK managed)
    match /short_codes/{code} {
      allow read, write: if isAdmin();
    }

    // 4. Store settings
    // Public store info: store name, working hours, shipping costs, banners, social links, CMS texts
    match /settings/public {
      allow read, write: if true;
    }

    // Private settings: banking info, ntfy topics, admin configs, credentials
    // Strictly restricted to authenticated admins
    match /settings/private {
      allow read, write: if isAdmin();
    }

    // Default deny for all other /settings documents (e.g., legacy main, admin, secrets)
    match /settings/{otherSetting} {
      allow read, write: if isAdmin();
    }

    // 5. Connection test collection (Read-only single doc, no writes)
    match /test/{testId} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
