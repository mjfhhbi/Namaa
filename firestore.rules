rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products collection: public read for all devices/phones, allow create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: public create for checkout, read for tracking and admin dashboard
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Store settings: public read for bank details, WhatsApp, and CMS text; allow update
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
