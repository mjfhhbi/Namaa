{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Natural food product available for purchase in Nama store",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the product"
        },
        "name": {
          "type": "string",
          "description": "Name of the product in Persian"
        },
        "category": {
          "type": "string",
          "description": "Product category: honey, dates, syrup, saffron_tea, extracts_oils"
        },
        "price": {
          "type": "number",
          "description": "Price in Tomans"
        },
        "originalPrice": {
          "type": "number",
          "description": "Original non-discounted price in Tomans"
        },
        "weight": {
          "type": "string",
          "description": "Weight or volume specification"
        },
        "description": {
          "type": "string",
          "description": "Full product description and properties"
        },
        "origin": {
          "type": "string",
          "description": "Geographical origin of production"
        },
        "stock": {
          "type": "number",
          "description": "Available stock quantity"
        },
        "image": {
          "type": "string",
          "description": "Product image URL or data URI"
        },
        "isPopular": {
          "type": "boolean",
          "description": "Whether to highlight as featured/bestseller"
        },
        "isOrganic": {
          "type": "boolean",
          "description": "Organic certification badge"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "name", "category", "price", "stock", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with card-to-card verification details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order tracking identifier"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the recipient"
        },
        "customerPhone": {
          "type": "string",
          "description": "Iranian mobile number for SMS/delivery"
        },
        "address": {
          "type": "string",
          "description": "Detailed delivery postal address"
        },
        "postalCode": {
          "type": "string",
          "description": "10-digit postal code"
        },
        "subtotal": {
          "type": "number",
          "description": "Products subtotal in Tomans"
        },
        "shippingCost": {
          "type": "number",
          "description": "Postage shipping fee in Tomans"
        },
        "totalAmount": {
          "type": "number",
          "description": "Final payable amount in Tomans"
        },
        "status": {
          "type": "string",
          "enum": ["pending_receipt", "paid_pending_approval", "approved", "packaging", "shipped", "cancelled"],
          "description": "Current order lifecycle status"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method: card_to_card"
        },
        "cardLast4": {
          "type": "string",
          "description": "Last 4 digits of customer paying card"
        },
        "paymentReference": {
          "type": "string",
          "description": "Bank transfer tracking/reference number"
        },
        "receiptImage": {
          "type": "string",
          "description": "Bank receipt image URI"
        },
        "trackingCode": {
          "type": "string",
          "description": "Iran Post postal tracking parcel code"
        },
        "notes": {
          "type": "string",
          "description": "Customer notes or admin internal remarks"
        },
        "createdAt": {
          "type": "string",
          "description": "Order creation ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Order last status update timestamp"
        }
      },
      "required": ["id", "customerName", "customerPhone", "address", "totalAmount", "status", "createdAt"]
    },
    "PublicSettings": {
      "title": "PublicSettings",
      "description": "Public store configuration, branding, working hours, CMS texts and shipping rates",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "slogan": { "type": "string" },
        "shippingCost": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "supportPhone": { "type": "string" },
        "supportWhatsApp": { "type": "string" },
        "supportInstagram": { "type": "string" },
        "supportTelegram": { "type": "string" },
        "supportAddress": { "type": "string" },
        "announcement": { "type": "string" },
        "isStoreOpen": { "type": "boolean" },
        "aboutText": { "type": "string" },
        "heroBadge": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroButtonText": { "type": "string" },
        "promoBadge": { "type": "string" },
        "promoTitle": { "type": "string" },
        "promoSubtitle": { "type": "string" },
        "qualityBadge1": { "type": "string" },
        "qualityBadge2": { "type": "string" },
        "qualityBadge3": { "type": "string" },
        "qualityBadge4": { "type": "string" }
      },
      "required": ["storeName", "shippingCost"]
    },
    "PrivateSettings": {
      "title": "PrivateSettings",
      "description": "Sensitive administrative settings, bank card details, sheba, ntfy topic, and discount codes",
      "type": "object",
      "properties": {
        "cardNumber": { "type": "string" },
        "cardHolder": { "type": "string" },
        "bankName": { "type": "string" },
        "shabaNumber": { "type": "string" },
        "ntfyTopic": { "type": "string" },
        "zarinpalMerchantId": { "type": "string" }
      },
      "required": ["cardNumber", "cardHolder"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of food catalog products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders with verification and shipment records"
    },
    "/settings/public": {
      "schema": "PublicSettings",
      "description": "Public store settings readable by all store visitors"
    },
    "/settings/private": {
      "schema": "PrivateSettings",
      "description": "Confidential store banking and notification configuration restricted to admins"
    }
  }
}
