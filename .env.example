# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PIN: Strong passcode for administrative server login (minimum 6 characters recommended)
# For security, PIN login is disabled if left unset.
ADMIN_PIN=""

# -------------------------------------------------------------
# FIREBASE SERVER & ADMIN SDK CONFIGURATION
# -------------------------------------------------------------

# Option 1: Direct JSON or Base64 string of the service account key
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Option 2: Path to service account JSON file on disk
# FIREBASE_SERVICE_ACCOUNT_PATH="./service-account-key.json"

# Target Firebase Project ID (optional: defaults to operational project, set to test project ID when testing)
# FIREBASE_PROJECT_ID="nama-store-test-sandbox"

# Target Firestore Database ID (optional: set to (default) for standard projects, or explicit ID)
# FIRESTORE_DATABASE_ID="(default)"

# Local Firestore Emulator (for testing with emulator without real credentials)
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
